@using WebApplication.Helper
@model Model.School
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Thêm mới trường</h4>
            </div>
            @using (Html.BeginForm("Create", "School", FormMethod.Post, new { @id = "CreateSchool" }))
            {
                <div class="modal-body">
                    @Html.ValidationSummary(true)
                    <div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12">Tên trường</label>
                                <div class="col-xs-12">
                                    @Html.HiddenFor(x => x.SchoolId, new { @class = "form-control"})
                                    @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12">Mã trường</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.Code, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12">Mã tỉnh thành</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.CityCode, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12">Mã quận huyện</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.DistrictCode, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="form-group  col-md-6">
                                <label class="control-label col-xs-12">Hình thức triển khai</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.DeploymentMethod, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="form-group  col-md-6">
                                <label class="control-label col-xs-12">Số học sinh</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.NumberOfStudent, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="form-group  col-md-6">
                                <label class="control-label col-xs-12">Cho phép in giáo án</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.PrintDocument, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="form-group  col-md-6">
                                <label class="control-label col-xs-12">Giấy chứng nhận</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.Certificate, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <label id="errormsg" class="error" style="display: inline-block;"></label>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i>Lưu
                    </button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        <i class="fa fa-close"></i>Hủy
                    </button>
                </div>
            }
        </div>

    </div>
    <script>
        jQuery(document).ready(function () {
            $(".ace-checkbox").find("input[type='hidden']").remove();
            App.School.initForm();
        });

    </script>
</div>
