@model  DataModel.Base.PagedData<Model.School>
<table id="sample-table-1" class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th class="center">Id</th>
            <th>Tên trường</th>
            <th>Mã trường</th>
            <th>Mã tỉnh thành</th>
            <th>Mã quận huyện</th>
            <th>Phương thức triển khai</th>
            <th>Số học sinh</th>
            <th>Số giáo viên</th>
            <th>In giáo án</th>
            <th>Giấy chứng nhận</th>
            <th width="140"></th>
        </tr>
    </thead>

    <tbody>
        @{
            foreach (var school in Model.Data)
            {
            <tr>
                <td class="center">
                    @school.SchoolId
                </td>
                <td>
                    <a href="#">@school.Name</a>
                </td>
                <td>@school.Code</td>
                <td>@school.CityCode</td>
                <td>@school.DistrictCode</td>
                <td>@school.DeploymentMethod</td>
                <td>@school.NumberOfStudent</td>
                <td>@school.NumberOfTeacher</td>
                <td>@school.PrintDocument</td>
                <td>@school.Certificate</td>

                <td>
                    <a href="#" onclick="App.School.editSchoolClick('@school.SchoolId')" class="btn btn-xs btn-info">
                        <i class="icon-edit bigger-120"></i>Sửa
                    </a>
                    <a href="#" onclick="App.School.ShowLog('@school.SchoolId',this)" class="btn btn-xs btn-info">
                        <i class="icon-search bigger-120"></i>Xem lịch sử
                    </a>
                </td>
            </tr>
            }
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="11" align="right">
                @{
                    Html.RenderPartial("Pagination", Model.Pagination);
                }
            </td>
        </tr>
    </tfoot>
</table>
<script>
    $(".ace-checkbox").find("input[type='hidden']").remove();
</script>
