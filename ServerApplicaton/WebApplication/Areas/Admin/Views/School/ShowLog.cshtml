@using WebApplication.Helper @model Model.School
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" style="width: 800px">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Lịch sử</h4>
            </div>
            <div class="modal-body">
                <div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="control-label  col-xs-12">Mã trường</label>
                            <div class="col-xs-12">
                                @Html.TextBoxFor(x => x.Code, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="control-label  col-xs-12">Tên trường</label>
                            <div class="col-xs-12">
                                @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                    <table id="sample-table-1" class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Người cập nhật</th>
                                <th>Ngày</th>
                                <th>Nội dung</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                if (!Model.SchoolLogs.Any())
                                {
                                <tr>
                                    <td colspan="6">Chưa có dữ liệu</td>
                                </tr>
                                }
                                else
                                {
                                    foreach (var answer in Model.SchoolLogs)
                                    {
                                <tr>
                                    <td>
                                        @answer.UserName
                                    </td>

                                    <td>
                                        @answer.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")
                                    </td>
                                    <td>
                                        @answer.Description
                                    </td>

                                </tr>
                                    }
                                }
                                
                            }
                        </tbody>

                    </table>
                </div>

                    <div class="clear-fix"></div>
                </div>
            </div>
        </div>
    </div>
    <script>
        //jQuery(document).ready(function () {
        //    App.School.initForm();
        //});

    </script>
</div>
