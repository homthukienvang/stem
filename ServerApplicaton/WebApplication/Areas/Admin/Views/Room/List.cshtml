@model DataModel.Base.PagedData<Model.Room>

<table id="sample-table-1" class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th class="center">ID</th>
            <th>Mã lớp học</th>
            <th>Tên lớp học</th> 
            <th>Môn học</th> 
            <th >Khóa</th>
            <th width="140"></th>
        </tr>
    </thead>

    <tbody>
        @{
            foreach (var room in Model.Data)
            {
                <tr>
                    <td class="center">
                        @room.RoomId
                    </td>

                    <td>
                        <a href="#">@room.Code</a>
                    </td>
                    <td>
                        <a href="#">@room.Name</a>
                    </td>
                    <td>@room.SubjectName</td>
                    <td class="">
                        <label class="ace-checkbox">
                            @Html.CheckBoxFor(x => room.IsLocked, new { @class = "ace", disabled = "disabled" })
                            <span class="lbl"></span>
                        </label>
                    </td>
                    <td>
                        @*<div class="visible-md visible-lg hidden-sm hidden-xs btn-group">*@
                            <a href="#" onclick="App.Room.editRoomClick('@room.RoomId')" class="btn btn-xs btn-info">
                                <i class="icon-edit bigger-120"></i>  Sửa
                            </a>  
                            @*<a href="#" onclick="App.Room.deleteRoomClick('@room.RoomId')" class="btn btn-xs btn-danger">
                                <i class="icon-trash  bigger-120"></i> Xóa
                            </a>*@
                        @*</div>*@
                    </td>
                </tr>
            }
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="8" align="right">
                @{
                    Html.RenderPartial("Pagination", Model.Pagination);
                }
            </td>
        </tr>
    </tfoot>

</table>
<script>
    $(".ace-checkbox").find("input[type='hidden']").remove();
</script>