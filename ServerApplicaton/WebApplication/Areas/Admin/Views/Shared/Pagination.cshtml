@model  DataModel.Base.PaginationModel
<div class="dataTables_paginate paging_bootstrap">
    <ul class="pagination pull-left"><li class="first"><a href="#"> Tổng số: <b>@Model.NumberOfRows </b> dòng</a></li></ul>
    <ul id="pagination-demo" class="pagination pull-right">
        <li class="first" pageindex="0" onclick="GotoPage(this)"><a href="javascript:void(0)">Trang đầu</a></li>
        @if (Model.CurrentPage == 0)
        {
            <li class="prev disabled"><a href="javascript:void(0)">Trước</a></li>
        }
        else
        {
            <li class="prev" pageindex="@(Model.CurrentPage - 1)" onclick="GotoPage(this)"><a href="javascript:void(0)">Trước</a></li>
        }

        @{
            var start = Model.CurrentPage - 4;
            var end = Model.CurrentPage + 6;
            if (Model.NumberOfPages <= 11)
            {
                start = 1;
                end = Model.NumberOfPages;
            }
            else
            {
                if (start <= 0)
                {
                    start = 1;
                    end = 11;
                }
                else
                {
                    if (end > Model.NumberOfPages)
                    {
                        start = Model.NumberOfPages - 11;
                        end = Model.NumberOfPages;
                    }
                }
            }
        }

        @for (int i = start; i <= end; i++)
        {
            if (i == Model.CurrentPage + 1)
            {
                <li class="page active" pageindex="@(i-1)"><a href="javascript:void(0)">@i / @Model.NumberOfPages</a></li>
            }
            else
            {
                <li class="page" pageindex="@(i-1)" onclick="GotoPage(this)"><a href="javascript:void(0)">@i</a></li>
            }

        }
        @if (Model.CurrentPage == Model.NumberOfPages - 1)
        {
            <li class="next disabled" pageindex="@(Model.CurrentPage + 1)"><a href="javascript:void(0)">Sau</a></li>
        }
        else
        {
            <li class="next" pageindex="@(Model.CurrentPage + 1)" onclick=" GotoPage(this) "><a href="javascript:void(0)">Sau</a></li>
        }

        <li class="last" pageindex="@( Model.NumberOfPages - 1)" onclick="GotoPage(this)"><a href="javascript:void(0)">Trang cuối</a></li>
    </ul>
</div>