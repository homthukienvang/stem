@using WebApplication.Helper @model Model.Feedback
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" style="width: 800px">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Cập nhật</h4>
            </div>
            @using (Html.BeginForm("Edit", "Feedback", FormMethod.Post, new { @id = "CreateFeedback" }))
            {
                <div class="modal-body">
                    @Html.ValidationSummary(true)
                    <div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12"> Tên giáo viên</label>
                                <div class="col-xs-12">
                                    @Html.HiddenFor(x => x.FeedbackId, new { @class = "form-control", @placeholder = " Name" })
                                    @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12"> Phone</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.Phone, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12"> Email</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12"> Bài học</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.LessonName, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12"> Ngày</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.CommentTime, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="form-group  col-md-12">
                                <label class="control-label col-xs-12"> Ý kiến giáo viên</label>
                                <div class="col-xs-12">
                                    @Html.TextAreaFor(x => x.Comment, new { @class = "form-control",@rows = 10 })
                                </div>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                        <div class="row">
                            <label class="control-label col-xs-12">Hình ảnh đính kèm</label>
                            <table id="sample-table-1" class="table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        if (!Model.FeedBackFiles.Any())
                                        {
                                        <tr>
                                            <td colspan="6">Không có hình ảnh đính kèm</td>
                                        </tr>
                                        }
                                        else
                                        {
                                            foreach (var answer in Model.FeedBackFiles)
                                            {
                                        <tr>
                                            <td>
                                                <img src="/upload/@answer.FileName" width ="750px" />
                                            </td>
                                        </tr>
                                            }
                                        }
                                
                                    }
                                </tbody>

                            </table>
                        </div>
                    </div>
                    <div class="clear-fix"></div>
                </div>
                <div class="modal-footer">
                    <label id="errormsg" class="error" style="display: inline-block;"></label>
                     
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        <i class="fa fa-close"></i> Hủy
                    </button>
                </div>
            }
        </div>

    </div>
    <script>
        jQuery(document).ready(function () {
            $(".ace-checkbox").find("input[type='hidden']").remove();

            App.Feedback.initForm();
        });

    </script>
</div>