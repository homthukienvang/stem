@model  Model.Feedback

<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width: 900px">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Lịch sử giao dịch</h4>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("ShowAnswer", "Feedback", FormMethod.Post, new { @id = "ShowAnswer" }))
                {
                    @Html.ValidationSummary(true)
                    <div>
                        <div class="row">
                            <label class="control-label  col-xs-12">Ý kiến khách hàng: <b>@Model.Name</b> </label>
                            <div class="col-xs-12">
                                @Html.HiddenFor(x => x.FeedbackId, new { @class = "form-control" })
                                @Html.HiddenFor(x => x.UserId, new { @class = "form-control" })
                                @Html.HiddenFor(x => x.UserName, new { @class = "form-control" })
                                @Html.TextAreaFor(x => x.Comment, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-xs-12">Nội dung trả lời</label>
                            <div class="col-xs-12">
                                <textarea class="form-control " id="Answer" name="Description"></textarea>
                            </div>
                        </div>
                        <div class="row">
                            <label id="errormsg" class="error col-md-12" style="display: inline-block;"></label>
                            <div class="form-group">

                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save"></i>Lưu
                                </button>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                    </div>
                }
                <div class="row">
                    <table id="sample-table-1" class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Người trả lời</th>
                                <th>Ngày</th>
                                <th>Nội dung</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                if (!Model.FeedbackAnswers.Any())
                                {
                                <tr>
                                    <td colspan="6">Chưa có dữ liệu</td>
                                </tr>
                                }
                                else
                                {
                                    foreach (var answer in Model.FeedbackAnswers)
                                    {
                                <tr>
                                    <td>
                                        @answer.UserName
                                    </td>

                                    <td>
                                        @answer.AnswerTime.Value.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @answer.Answer
                                    </td>
                                    <td>
                                        @(answer.Status == 0 ? "Chưa xem" : "Đã xem")
                                    </td>

                                </tr>
                                    }
                                }
                                
                            }
                        </tbody>

                    </table>
                </div>
            </div>
            <div class="modal-footer">

                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="fa fa-close"></i>Hủy
                </button>
            </div>
        </div>

    </div>
    <script>
        jQuery(document).ready(function () {
            App.Feedback.initFeedbackAnswer();
        });

    </script>
</div>

