@model DataModel.Base.PagedData<Model.Subject>

<table id="sample-table-1" class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th class="center">ID</th>
            <th>Mã môn học</th>
            <th>Tên môn học</th> 
            <th >Khóa</th>
            <th width="140"></th>
        </tr>
    </thead>

    <tbody>
        @{
            foreach (var Subject in Model.Data)
            {
                <tr>
                    <td class="center">
                        @Subject.SubjectId
                    </td>

                    <td>
                        <a href="#">@Subject.Code</a>
                    </td>
                    <td>
                        <a href="#">@Subject.Name</a>
                    </td>            
                    <td class="">
                        <label class="ace-checkbox">
                            @Html.CheckBoxFor(x => Subject.IsLocked, new { @class = "ace", disabled = "disabled" })
                            <span class="lbl"></span>
                        </label>
                    </td>
                    <td>
                            <a href="#" onclick="App.Subject.editSubjectClick('@Subject.SubjectId')" class="btn btn-xs btn-info">
                                <i class="icon-edit bigger-120"></i>  Sửa
                            </a>  
                            @*<a href="#" onclick="App.Subject.deleteSubjectClick('@Subject.SubjectId')" class="btn btn-xs btn-danger">
                                <i class="icon-trash  bigger-120"></i> Xóa
                            </a>*@
                    </td>
                </tr>
            }
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="8" align="right">
                @{
                    Html.RenderPartial("Pagination", Model.Pagination);
                }
            </td>
        </tr>
    </tfoot>

</table>
<script>
    $(".ace-checkbox").find("input[type='hidden']").remove();
</script>