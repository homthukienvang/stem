@{
    ViewBag.Title = "Quản lý giáo viên";
}
@model DataModel.Base.PagedData<Model.Client>
    <script src="~/assets/adminjs/Client.js?v=8"></script>

    <style>
        .clientsearchbox {
            width: 130px !important;
            float: left;
            margin-right: 5px;
        }
    </style>

    <!-- Modal -->
    <div id="AddForm"></div>
    <div class="row">
        <div class="col-xs-12">
            <div class="form-group">
                <input id="tClass" name="tClass" placeholder="Lớp" class="clientsearchbox" type="text" value="">
                <input id="tSchoolCode" name="tSchoolCode" placeholder="Mã trường" class="clientsearchbox" type="text" value="">
                <input id="tCityCode" name="tCityCode" placeholder="Mã tỉnh/thành" class="clientsearchbox" type="text" value="">
                <input id="tDistrictCode" name="tDistrictCode" placeholder="Mã quận/huyện" class="clientsearchbox" type="text" value="">
                <input id="tFullName" name="tFullName" placeholder="Username" class="clientsearchbox" type="text" value="">
                <input id="tDeployMethod" name="tDeployMethod" placeholder="Phương thức triển khai" class="clientsearchbox" type="text" value="">
                <select class="form-control input-sm clientsearchbox" data-val="true" id="ddlApproved" name="ddlApproved">
                    <option value="-1" selected="selected">--Trạng thái--</option>
                    <option value="0">Chờ duyệt</option>
                    <option value="1">Đã duyệt</option>
                </select>
                <button onclick="Search()" class="btn btn-xs btn-primary">
                    <i class="fa fa-search"></i>
                    Tìm kiếm
                </button>
            </div><!-- #nav-search -->
        </div>
        <div class="col-xs-12 position-relative">
            <div class="form-group stickytop-panel">
                <button data-toggle="modal" id="AddClient" onclick="App.Client.addClientClick()" class="btn btn-xs btn-primary">
                    <i class="fa fa-plus"></i>
                    Thêm mới
                </button>
                <a href="@Url.Action("ImportClient")" class="btn btn-xs btn-primary">
                    <i class="fa fa-play-circle"></i>
                    Import giáo viên
                </a>
                <a href="#" onclick="App.Client.exportListClientClick()" class="btn btn-xs btn-success">
                    <i class="icon-download bigger-120"></i> Export
                </a>

                <a href="#" onclick="App.Client.showLessonListClientClick()" class="btn btn-xs btn-success">
                    <i class="icon-file bigger-120"></i> Cập nhật bài học
                </a>

                <a href="#" onclick="App.Client.lockClientClick(true)" class="btn btn-xs btn-warning">
                    <i class="icon-lock bigger-120"></i> Khóa
                </a>
                <a href="#" onclick="App.Client.lockClientClick(false)" class="btn btn-xs btn-warning">
                    <i class="icon-unlock bigger-120"></i> Mở Khóa
                </a>
                <a href="#" onclick="App.Client.deleteClients()" class="btn btn-xs btn-danger">
                    <i class="icon-trash bigger-120"></i> Xóa
                </a>
                <label id="errormsg" class="error" style="display: inline-block;"></label>
            </div>


        </div>
    </div>

    <div class="clear-fix"></div>

    <div class="row">
        <div class="col-xs-12">
            <div class="table-responsive">
                <div id="result">
                    @{
                        Html.RenderPartial("List", Model);
                    }
                </div>

            </div><!-- /.table-responsive -->
        </div><!-- /span -->
    </div><!-- /row -->

    <div class="hr hr-18 dotted hr-double"></div>
