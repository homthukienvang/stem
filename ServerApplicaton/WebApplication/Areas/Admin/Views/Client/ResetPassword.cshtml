@model  Model.Client

<div id="myModal" class="modal fade" User="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Reset mật khẩu</h4>
            </div>
            @using (Html.BeginForm("ResetPassword", "Client", FormMethod.Post, new { @id = "CreateClient" }))
            {
                <div class="modal-body">
                    @Html.HiddenFor(x => x.ClientId)
                    @Html.ValidationSummary(true)
                    <div>
                        <div class="row">
                            <div class="col-md-12">

                                <div class="form-group col-xs-12">
                                    <label class="control-label  col-xs-12"> Tên đăng nhập</label>
                                    <div class="col-xs-12">
                                        @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", @placeholder = " ", @disabled = "disabled" })
                                    </div>
                                </div>
                                <div class="form-group col-xs-12">
                                    <label class="control-label  col-xs-12"> Tên đầy đủ</label>
                                    <div class="col-xs-12">
                                        @Html.TextBoxFor(x => x.FullName, new { @class = "form-control", @disabled = "disabled" })
                                    </div>
                                </div><div class="form-group col-xs-12">
                                          <label class="control-label  col-xs-12"> Mật khẩu</label>
                                          <div class="col-xs-12">
                                              @Html.PasswordFor(x => x.PassWork, new { @class = "form-control" })
                                          </div>
                                      </div>
                                <div class="form-group col-xs-12">
                                    <label class="control-label  col-xs-12"> Xác nhận mật khẩu</label>
                                    <div class="col-xs-12">
                                        @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                             
                        </div>


                    </div>

                </div>
                <div class="modal-footer">
                    <label id="errormsg" class="error" style="display: inline-block;"></label>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Lưu
                    </button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        <i class="fa fa-close"></i> Hủy
                    </button>
                </div>
                                            }

        </div>

    </div>

    <script>
        jQuery(document).ready(function () {
            $(".ace-checkbox").find("input[type='hidden']").remove();
            App.Client.initForm();
        });

    </script>
</div>