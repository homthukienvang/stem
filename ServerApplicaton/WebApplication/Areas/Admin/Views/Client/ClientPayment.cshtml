@using System.Linq
@model  Model.Client 

<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width: 900px">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Lịch sử giao dịch</h4>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("ClientPayment", "Client", FormMethod.Post, new { @id = "ClientPayment" }))
                {

                    @Html.ValidationSummary(true)
                    <div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12"> Số tiền</label>
                                <div class="col-xs-12">
                                    @Html.HiddenFor(x => x.ClientId, new { @class = "form-control", @placeholder = " Name" })
                                    <input class="form-control " id="Amount" name="Amount" type="text">
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12"> Ngày thu</label>
                                <div class="col-xs-12">
                                    <input class="form-control datepicker" id="PaymentDate" name="PaymentDate" type="text">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12"> Bắt đầu từ ngày </label>
                                <div class="col-xs-12">
                                    <input class="form-control datepicker" id="BeginDate" name="BeginDate" type="text">
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="control-label  col-xs-12"> Đến ngày</label>
                                <div class="col-xs-12">
                                    <input class="form-control datepicker" id="EndDate" name="EndDate" type="text">
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="form-group  col-md-6">
                                <label class="control-label col-xs-12"> Người thu tiền</label>
                                <div class="col-xs-12">
                                    <input class="form-control " id="CreatedUserName" name="CreatedUserName" type="text">
                                </div>
                            </div>
                            <div class="form-group  col-md-6">
                                <label class="control-label col-xs-12"> Ghi chú</label>
                                <div class="col-xs-12">
                                    <textarea class="form-control " id="Description" name="Description"></textarea>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <label id="errormsg" class="error col-md-12"  style=" display :inline-block;"></label>
                            <div class="form-group"  >

                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save"></i> Lưu
                                </button>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                    </div>

                }
                <div class="row">
                    <table id="sample-table-1" class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Tổng số:</th>
                                <th>@Model.ClientPayments.Sum(x => x.Amount) VNĐ</th>
                            </tr>
                            <tr>
                                <th>Số tiền (VNĐ)</th>
                                <th>Ngày thanh toán</th>
                                <th>Sử dụng từ ngày </th>
                                <th>Đến ngày </th>
                                <th>Ghi chú </th>
                                <th>Người thu tiền </th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                if (!Model.ClientPayments.Any())
                                {
                                    <tr>
                                        <td colspan="6"> Chưa có dữ liệu</td>
                                    </tr>
                                }
                                else
                                {
                                      foreach (var client in Model.ClientPayments)
                                {
                                    <tr>
                                        <td>
                                            @client.Amount
                                        </td>

                                        <td>
                                            @client.PaymentDate.Value.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            @client.BeginDate.Value.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            @client.EndDate.Value.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            @client.Description
                                        </td>
                                        <td>
                                            @client.CreatedUserName
                                        </td>

                                    </tr>
                                }
                                }
                                
                            }
                        </tbody>

                    </table>
                </div>
            </div>
            <div class="modal-footer">

                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="fa fa-close"></i> Hủy
                </button>
            </div>
        </div>
        
    </div>
    <script>
        jQuery(document).ready(function () {
            $(".ace-checkbox").find("input[type='hidden']").remove();
            $('.datepicker').datepicker({
                orientation: 'bottom',
                autoclose: true,
                startDate: '1/1/1900',                
                language: 'vi'
            });
            App.Client.initClientPayments();
        });

    </script>
</div>

