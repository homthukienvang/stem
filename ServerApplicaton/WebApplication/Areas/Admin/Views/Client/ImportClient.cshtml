@{
    ViewBag.Title = "Import giáo viên";
}
@model  Model.ClientImport

<div class="container">
     
    </div>
    <!-- end: PAGE HEADER -->
    <!-- start: PAGE CONTENT -->
    <div class="row">
        <div class="col-md-12">
            <!-- start: DYNAMIC TABLE PANEL -->

            <div class="panel-body" id="ClassInfo">
                @using (Html.BeginForm("ImportClient", "Client", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {

                <div class="row">
                    <div class="col-md-12">
                        @if (Model != null && !string.IsNullOrEmpty(Model.Error))
                        {
                            <p style="color:red">@Html.Raw(Model.Error)</p>
                        }
                    </div>
                    <div>
                        <a href="~/Content/Import_template.xlsx">Download template</a>
                    </div>
                </div>
                    <div class="row">
                        <div class="col-md-6">

                            <div class="form-group">
                                <label class="control-label">
                                    Chọn file excell cần import
                                </label>
                                <input type="file" name="FileUpload" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label" style="display:block">
                                    Ấn nút import và chờ trong một vài phút để hệ thống thực hiện việc import
                                </label>
                                <input type="submit" id="submit" class="btn btn-primary icon-plus" value="Import" />

                            </div>
                        </div>
                    </div>


                }
            </div>
        </div>

        <!-- end: DYNAMIC TABLE PANEL -->
    </div>
</div>
<!-- end: PAGE CONTENT-->  