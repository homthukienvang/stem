@model DataModel.Base.PagedData<Model.Client>
<table id="sample-table-1" class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th class="center">
                <label class="ace-checkbox">
                    @Html.CheckBox("SelectAll", new { @class = "ace" })
                    <span class="lbl"></span>
                </label>
            </th>
            <th class="center">STT</th>
            <th>Tên đăng nhập</th>
            <th>Họ tên</th>
            <th>Lớp</th>
            <th>Số điện thoại</th>
            <th>Mã trường</th>
            <th>Mã Tỉnh thành</th>
            <th>Mã Huyện</th>
            <th>Mã Máy</th>

        </tr>
    </thead>

    <tbody>
        @{
            foreach (var client in Model.Data)
            {
            <tr>
                <td class="">
                    <label class="ace-checkbox">
                        @Html.CheckBoxFor(x => client.IsSelected, new { @class = "ace", @clientId = client.ClientId })
                        <span class="lbl"></span>
                    </label>
                </td>
                <td class="center">
                    @client.RowIndex
                </td>

                <td>
                    <a href="#">@client.UserName</a>
                </td>
                <td>
                    <a href="#">@client.FullName</a>
                </td>
                <td>@client.Email</td>
                <td>@client.Phone</td>
                <td>@client.SchoolCode</td>
                <td>@client.CityCode</td>
                <td>@client.DistrictCode</td>
                <td>@client.MacIp</td>
            </tr>
            }
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="14" align="right">
                @{
                    Html.RenderPartial("Pagination", Model.Pagination);
                }
            </td>
        </tr>
    </tfoot>

</table>
<script>
    $(".ace-checkbox").find("input[type='hidden']").remove();
    $("#sample-table-1 #SelectAll").change(function () {
        $("#sample-table-1 input[name^='client.IsSelected']").prop("checked", this.checked);
    });
</script>
