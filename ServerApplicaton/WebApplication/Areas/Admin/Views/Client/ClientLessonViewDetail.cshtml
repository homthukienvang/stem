@model  Model.Client

<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width: 900px">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Chi tiết download và sử dụng bài học cho giáo viên</h4>
            </div>

            <div class="modal-body" style="height: 550px; overflow: auto">
                <div class="row">
                    <table id="sample-table-1" class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Mã bài học</th>
                                <th>Tên bài học</th>
                                <th>Số lượt download</th>
                                <th>Số lượt sử dụng</th>
                                <th>Sử dụng lần cuối </th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                            
                                {
                                    foreach (var client in Model.ClientLessons)
                                    {
                                <tr>
                                    <td>
                                        @client.Code
                                    </td>

                                    <td>
                                        @client.Name
                                    </td>
                                    <td>
                                        @client.OpenCount
                                    </td>
                                    <td>
                                        @client.DownloadCount
                                    </td>
                                    <td>
                                        @*@if (client.LastOpen != null)
                                                           {
                                                               @client.LastOpen.Value.ToString("dd/MM/yyyy hh:mm:ss")
                                                           }*@
                                        @if (string.IsNullOrEmpty(client.LastUse))
                                        {
                                            @client.LastOpen.Value.ToString("dd/MM/yyyy hh:mm:ss")
                                        } else {
                                            @client.LastUse
                                        }
                                    </td>
                                </tr>
                                    }
                                }

                            }
                        </tbody>

                    </table>
                </div>
            </div>
            <div class="modal-footer">

                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="fa fa-close"></i>Đóng
                </button>
            </div>

        </div>

    </div>
    <script>
        jQuery(document).ready(function () {
            $(".ace-checkbox").find("input[type='hidden']").remove();
            App.Client.initClientLessons();
            $("input[name='ShowLesson']").change(function () {
                var roomid = $(this).attr("roomid");
                if ($(this).is(":checked")) {

                    $(".ShowLessonGroup[roomid='" + roomid + "']").show();
                } else {

                    $(".ShowLessonGroup[roomid='" + roomid + "']").hide();
                }
            });
        });

    </script>
</div>
