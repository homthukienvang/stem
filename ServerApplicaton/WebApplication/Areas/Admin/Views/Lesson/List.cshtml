@model DataModel.Base.PagedData<Model.Lesson>

    <table id="sample-table-1" class="table table-striped table-hover">
        <thead>
            <tr>
                <th class="center">
                    <label class="ace-checkbox">
                        @Html.CheckBox("SelectAll", new { @class = "ace" })
                        <span class="lbl"></span>
                    </label>
                </th>
                <th class="center">#</th>
                <th class="center"></th>
                <th>Mã bài học</th>
                <th>Tên bài học</th>
                <th>Môn học</th>
                <th>Lớp học</th>
                <th>Khóa</th>
                <th width="160"></th>
            </tr>
        </thead>

        <tbody>
            @{
                foreach (var lesson in Model.Data)
                {
                    <tr>
                        <td>
                            <label class="ace-checkbox">
                                @Html.CheckBoxFor(x => lesson.IsSelected, new { @class = "ace", @lessonId = lesson.LessonId })
                                <span class="lbl"></span>
                            </label>
                        </td>
                        <td>@lesson.LessonId</td>
                        <td class="center">
                            <img style="width:60px" src="@(string.IsNullOrEmpty(lesson.NormalImage) ? "/Content/themes/base/images/icon.png" : string.Format("/Images/{0}", lesson.NormalImage))" />
                        </td>
                        <td>
                            <a href="javascript:;">@lesson.Code</a>
                        </td>
                        <td>
                            <a href="javascript:;">@lesson.Name</a>
                        </td>
                        <td>@lesson.SubjectName</td>
                        <td>@lesson.RoomName</td>
                        <td class="">
                            <label class="ace-checkbox">
                                @Html.CheckBoxFor(x => lesson.IsLocked, new { @class = "ace IsLocked", lessonid = lesson.LessonId })
                                <span class="lbl"></span>
                            </label>
                        </td>
                        <td>
                            <div style="width:168px">
                                <a href="javascript:;" onclick="App.Lesson.uploadDocumentClick('@lesson.LessonId')" class="btn btn-xs btn-primary width-80px">
                                    <i class="icon-upload"></i>Tài liệu
                                </a>
                                <a href="javascript:;" onclick="App.Lesson.editLessonClick('@lesson.LessonId')" class="btn btn-xs btn-info width-80px">
                                    <i class="icon-edit"></i>Sửa
                                </a>
                                <div class="margin-top-3px"></div>
                                @{
                                    if (lesson.IsLocked)
                                    {
                                        <a href="javascript:;" onclick="App.Lesson.lockLesson('@lesson.LessonId', false)" class="btn btn-xs btn-success width-80px">
                                            <i class="icon-unlock"></i>Mở Khóa
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="javascript:;" onclick="App.Lesson.lockLesson('@lesson.LessonId', true)" class="btn btn-xs btn-warning width-80px">
                                            <i class="icon-lock"></i>Khóa
                                        </a>
                                    }
                                }
                                <a href="javascript:;" onclick="App.Lesson.deleteLessonClick('@lesson.LessonId')" class="btn btn-xs btn-danger width-80px">
                                    <i class="icon-trash "></i>Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
        <tfoot class="sticky-panel">
            <tr>
                <td colspan="9" align="right">
                    @{
                        Html.RenderPartial("Pagination", Model.Pagination);
                    }
                </td>
            </tr>
        </tfoot>

    </table>
    <script>
        $(".ace-checkbox").find("input[type='hidden']").remove();
        jQuery(document)
            .ready(function () {
                $("input[name='lesson.IsLocked']")
                    .change(function () {
                        var lessonid = $(this).attr("lessonid");
                        App.Lesson.lockLesson(lessonid, $(this).is(":checked"));
                    });
            });
        $(".ace-checkbox").find("input[type='hidden']").remove();
        $("#sample-table-1 #SelectAll").change(function () {
            $("#sample-table-1 input[name^='lesson.IsSelected']").prop("checked", this.checked);
        });
    </script>
