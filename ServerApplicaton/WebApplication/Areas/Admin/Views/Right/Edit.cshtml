@model  Model.Right
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Cập nhật</h4>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("Edit", "Right", FormMethod.Post, new { @id = "EditRight" }))
                {
                    @Html.ValidationSummary(true)
                    @Html.HiddenFor(x => x.RightId)
                    <div>
                        <div class="row">
                            <div class="form-group col-xs-6">
                                <label class="control-label  col-xs-12"> Tên</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.RightName, new { @class = "form-control", @placeholder = " Name" })
                                </div>
                            </div>
                            <div class="form-group col-xs-6">
                                <label class="control-label col-xs-12">Tên hiển thị trên menu</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.NameInMenu, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-xs-6">
                                <label class="control-label col-xs-12"> Chức năng cha</label>
                                <div class="col-xs-12">
                                    @Html.DropDownListFor(model => model.ParentId, ViewBag.ParentRights as SelectList, "[Chức năng cha]", new { @class = "editor-textbox" })
                                </div>
                            </div>
                            <div class="form-group col-xs-6">
                                <label class="control-label col-xs-12"> Order</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.Order, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            
                            <div class="form-group col-xs-12">
                                <label class="control-label col-xs-12"> Url</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.Url, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group  col-xs-6">
                                <span class="control-label col-xs-12 ace-checkbox">
                                    <label class="middle">
                                        @Html.CheckBoxFor(x => x.ShowInMenu, new { @class = "ace form-control" })
                                        <span class="lbl"> Hiển thị menu</span>
                                    </label>
                                </span>
                            </div>
                            <div class="form-group  col-xs-6">
                                <span class="control-label col-xs-12 ace-checkbox">
                                    <label class="middle">
                                        @Html.CheckBoxFor(x => x.Status, new { @class = "ace form-control" })
                                        <span class="lbl"> Active</span>
                                    </label>
                                </span>
                            </div>
                        </div>




                    </div>
                }

            </div>
            <div class="modal-footer">
                <label id="errormsg" class="error" style="display: inline-block;"></label>
                <button type="button" class="btn btn-primary" onclick="App.Right.editRight()">
                    <i class="fa fa-save"></i> Lưu
                </button>
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="fa fa-close"></i> Hủy
                </button> 
                @if (true)
                {
                    <button type="button" class="btn btn-danger" style="margin-left: 20px" onclick="App.Right.deleteRightClick('@Model.RightId')">
                        <i class="fa fa-remove"></i> Xóa
                    </button>
                }
            </div>
        </div>

    </div>
    <script>
        jQuery(document).ready(function () {
            $(".ace-checkbox").find("input[type='hidden']").remove();
        });

    </script>
</div>