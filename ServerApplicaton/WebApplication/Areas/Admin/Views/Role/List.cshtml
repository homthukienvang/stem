@model DataModel.Base.PagedData<Model.Role>

     
    <table id="sample-table-1" class="table table-striped table-bordered table-hover">
            <thead>
                <tr>
                    <th class="center">Id</th> 
                    <th>Tên</th> 
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th width="140"></th>
                </tr>
            </thead>

            <tbody>
                @{
                    foreach (var Role in Model.Data)
                    {
                        <tr>
                            <td class="center">
                                @Role.RoleId
                            </td> 
                            <td>
                                <a href="#">@Role.RoleName</a>
                            </td>
                            <td>@Role.RoleDesc</td> 
                            <td class="">
                                <label class="ace-checkbox">
                                    @Html.CheckBoxFor(x => Role.RoleActivated, new { @class = "ace", disabled = "disabled" })
                                    <span class="lbl"></span>
                                </label>
                            </td> 
                            <td>
                                    <a href="#" onclick="App.Role.editRoleClick('@Role.RoleId')" class="btn btn-xs btn-info">
                                        <i class="icon-edit bigger-120"></i>  Sửa
                                    </a>

                                    <a href="#" onclick="App.Role.deleteRoleClick('@Role.RoleId')" class="btn btn-xs btn-danger">
                                        <i class="icon-trash  bigger-120"></i> Xóa
                                    </a>
                            </td>
                        </tr>
                    }
                }
            </tbody> 
        </table>
    <script>
        $(".ace-checkbox").find("input[type='hidden']").remove();
    </script>
