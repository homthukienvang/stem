@using System.Linq
@model  Model.Role
<script type="text/javascript">
    $(document).ready(function () {
        $("#browser").treeview();
    });
</script>
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width:900px;">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Thêm mới</h4>
            </div>
            @using (Html.BeginForm("Create", "Role", FormMethod.Post, new { @id = "CreateRole" }))
            {
                <div class="modal-body">
                    @Html.HiddenFor(x => x.RoleId)
                    @Html.ValidationSummary(true)
                    <div>
                        <div class="row">
                            <div class="col-md-6">

                                <div class="form-group col-xs-12">
                                    <label class="control-label  col-xs-12"> Tên vai trò</label>
                                    <div class="col-xs-12">
                                        @Html.TextBoxFor(x => x.RoleName, new { @class = "form-control", @placeholder = " Name" })
                                    </div>
                                </div>
                                <div class="form-group col-xs-12">
                                    <label class="control-label col-xs-12">Mô tả</label>
                                    <div class="col-xs-12">
                                        @Html.TextAreaFor(x => x.RoleDesc, new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group  col-xs-12">
                                    <span class="control-label col-xs-12 ace-checkbox">
                                        <label class="middle">
                                            @Html.CheckBoxFor(x => x.RoleActivated, new { @class = "ace form-control" })
                                            <span class="lbl"> Kích hoạt</span>
                                        </label>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="control-label col-xs-12">Quyền hạn</label>
                                <div class="col-xs-12" style="overflow: auto; max-height: 400px">
                                    <ul id="browser" class="filetree">
                                        @{
                                            var i = 1;
                                            var j = 1;
                                            foreach (var p in Model.Rights.Where(x => x.ParentId == 0 || x.ParentId == null))
                                            {
                                                if (Model.Rights.Any(x => x.ParentId == p.RightId))
                                                {
                                                    <li>
                                                        <a href="#">
                                                            <span class="control-label   ace-checkbox">
                                                                <label class="middle">
                                                                    @Html.CheckBoxFor(x => p.Selected, new { @class = "ace rightselect", @rightId = p.RightId })
                                                                    <span class="lbl"> @p.RightName</span>
                                                                </label>
                                                            </span>
                                                        </a>
                                                        <ul class="filetree">
                                                            @{
                                                                j = 1;
                                                                foreach (var c in Model.Rights.Where(x => x.ParentId == p.RightId))
                                                                {
                                                                    <li>
                                                                        <a href="#">
                                                                            <span class="control-label   ace-checkbox">
                                                                                <label class="middle">
                                                                                    @Html.CheckBoxFor(x => c.Selected, new { @class = "ace rightselect", @rightId = c.RightId })
                                                                                    <span class="lbl"> @c.RightName</span>
                                                                                </label>
                                                                            </span>
                                                                        </a>
                                                                    </li>
                                                                    j++;
                                                                }
                                                            }
                                                        </ul>
                                                    </li>
                                                                }
                                                                else
                                                                {
                                                                    <li>
                                                                        <a href="#">
                                                                            <span class="control-label   ace-checkbox">
                                                                                <label class="middle">
                                                                                    @Html.CheckBoxFor(x => p.Selected, new { @class = "ace rightselect", @rightId = p.RightId })
                                                                                    <span class="lbl"> @p.RightName</span>
                                                                                </label>
                                                                            </span>
                                                                        </a>
                                                                    </li>
                                                                    }
                                                                    i++;
                                                                }

                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>


                    </div>

                </div>
                <div class="modal-footer">
                    <label id="errormsg" class="error" style="display: inline-block;"></label>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Lưu
                    </button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        <i class="fa fa-close"></i> Hủy
                    </button>
                </div>
                                                                }

        </div>

    </div>
    <script>
        jQuery(document).ready(function () {
            $(".ace-checkbox").find("input[type='hidden']").remove();
            App.Role.initForm();
        });

    </script>
</div>