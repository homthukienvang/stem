@{
    ViewBag.Title = "Cập nhật quảng cáo người dùng";
}
@model  Model.Advertisement
<!-- Modal -->
<div id="AddForm"></div>
<div class="row">

</div>
<style>
    .validation-summary-errors {
    color: red;
    font-weight: bold;
    list-style-type: none;
}
</style>
<div class="clear-fix"></div>

<script>
    function removeFile(element) {
        $(element).parent().remove();
    }
    $(document).ready(function () {
        App.Common.UploadFile("#ImageUpload", function (data) {
            $("#AdvImage").val(data.result.name);
            $("#viewGuilde").attr("src","/Images/"+data.result.name);
        });
        
    });
</script>
<div class="row">
    <div class="col-xs-12">
        <div class="table-responsive">

            @using (Html.BeginForm("AdvertisementUser", "Advertisement", FormMethod.Post, new { @id = "AdvertisementUser" }))
            {
                <div class="">
                    @Html.ValidationSummary(true)
                    <div>
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label class="control-label  col-xs-12"> Tiêu đề</label>
                                <div class="col-xs-12">
                                    @Html.HiddenFor(x => x.Id, new { @class = "form-control", @placeholder = " Name" })
                                    @Html.TextBoxFor(x => x.Title, new { @class = "form-control", @placeholder = " Name" })
                                </div>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label class="control-label  col-xs-12"> Liên kết</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.AdvLink, new { @class = "form-control", @placeholder = " Name" })
                                </div>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label class="control-label  col-xs-12"> Số lần click trong ngày</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.ClickPerDay, new { @class = "form-control", @placeholder = " Name" })
                                </div>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label class="control-label  col-xs-12"> Tổng số lần click</label>
                                <div class="col-xs-12">
                                    @Html.TextBoxFor(x => x.ClickLinkCount, new { @class = "form-control", @placeholder = " Name" })
                                </div>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label class="control-label  col-xs-12"> Hình ảnh/Flash</label>
                                <div class="col-xs-12">
                                    <div id="ImageUpload">
                                         <div class="file_name">
                                           Tên file: <b>  @string.Format("/Images/{0}", Model.AdvImage) </b>
                                        </div>
                                        @Html.HiddenFor(x => x.AdvImage, new { @class = "form-control" })
                                        <span class="btn btn-xs btn-primary fileinput-button " style="margin-top: 10px">
                                            <i class="fa fa-plus-circle"></i> Thay đổi
                                            <input id="fileuploadIcon" class="fileupload" type="file" name="files[]">
                                        </span>
                                        <div class="progress" style="display: none">
                                            <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 60%;">
                                                <span class="sr-only">0% Complete</span>
                                            </div>
                                        </div>


                                    </div>


                                </div>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                    </div>


                </div>
                <div class="pull-left">
                    <label id="errormsg" class="error" style="display: inline-block; color: red;font-weight: bold"></label>

                    <button type="submit" class="btn btn-default btn-success ">
                        <i class="fa fa-save"></i> Lưu
                    </button>
                </div>
                @*<div style="border: 1px #ddd solid;clear: both;display: block;width: auto;float: left;margin: 5px;padding: 5px;">
                    <img id ="viewGuilde" style="display: block; width: auto; " src="@string.Format("/Images/{0}", Model.AdvImage)" />
                </div>*@
            }

        </div><!-- /.table-responsive -->
    </div><!-- /span -->
</div><!-- /row -->

<div class="hr hr-18 dotted hr-double"></div>
