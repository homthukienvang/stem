
@model  DataModel.Base.PagedData<Model.User>
<table id="sample-table-1" class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th class="center">Id</th>
            <th>Tên đăng nhập</th>
            <th>Tên đầy đủ</th>
            <th>Tỉnh thành quản lý</th>
            <th>Quận huyện quản lý</th>
            <th>Trạng thái</th>
            <th width="140"></th>
        </tr>
    </thead>

    <tbody>
        @{
            foreach (var item in Model.Data)
            {
                <tr>
                    <td class="center">
                        @item.UserId
                    </td>
                    <td>
                        <a href="#">@item.UserName</a>
                    </td>
                    <td>@item.DisplayName</td>
                    <td>@item.CityCode</td>
                    <td>@item.DistrictCode</td>
                    <td class="">
                        <label class="ace-checkbox">
                            @Html.CheckBoxFor(x => item.UserActivated, new { @class = "ace", disabled = "disabled" })
                            <span class="lbl"></span>
                        </label>
                    </td>
                    <td>

                        <a href="#" onclick="App.User.editUserClick('@item.UserId')" class="btn btn-xs btn-info">
                            <i class="icon-edit bigger-120"></i> Sửa
                        </a>

                        <a href="#" onclick="App.User.resetPassClick('@item.UserId')" class="btn btn-xs btn-info">
                            <i class="icon-refresh bigger-120"></i> Reset password
                        </a>
                        @if (item.UserName != "admin")
                        {
                            <a href="#" onclick="App.User.deleteUserClick('@item.UserId')" class="btn btn-xs btn-danger">
                                <i class="icon-trash  bigger-120"></i> Xóa
                            </a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<script>
    $(".ace-checkbox").find("input[type='hidden']").remove();
</script>
