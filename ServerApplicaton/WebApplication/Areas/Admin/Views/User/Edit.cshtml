@model  Model.User
<script type="text/javascript">
    $(document).ready(function () {
        $("#browser").treeview();
    });
</script>
<div id="myModal" class="modal fade" User="dialog">
    <div class="modal-dialog" style="width:900px;">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Thêm mới</h4>
            </div>
            @using (Html.BeginForm("Edit", "User", FormMethod.Post, new { @id = "CreateUser" }))
            {
                <div class="modal-body">
                    @Html.HiddenFor(x => x.UserId)
                    @Html.HiddenFor(x => x.UserName)

                    @Html.ValidationSummary(true)
                    <div>
                        <div class="row">
                            <div class="col-md-6">

                                <div class="form-group col-xs-12">
                                    <label class="control-label  col-xs-12"> Tên vai trò</label>
                                    <div class="col-xs-12">
                                        @Html.TextBox("UserNameDisplay", Model.UserName, new { @class = "form-control", @placeholder = " ", @disabled = "disabled" })
                                    </div>
                                </div>
                                <div class="form-group col-xs-12">
                                    <label class="control-label  col-xs-12"> Tên đầy đủ</label>
                                    <div class="col-xs-12">
                                        @Html.TextBoxFor(x => x.DisplayName, new { @class = "form-control", @placeholder = " " })
                                    </div>
                                </div>
                                <div class="form-group col-xs-12">
                                    <label class="control-label  col-xs-12"> Tỉnh thành quản lý</label>
                                    <div class="col-xs-12">
                                        @Html.TextBoxFor(x => x.CityCode, new { @class = "form-control", @placeholder = " " })
                                    </div>
                                </div>
                                <div class="form-group col-xs-12">
                                    <label class="control-label  col-xs-12"> Quận huyện quản lý</label>
                                    <div class="col-xs-12">
                                        @Html.TextBoxFor(x => x.DistrictCode, new { @class = "form-control", @placeholder = " " })
                                    </div>
                                </div>
                                <div class="form-group  col-xs-12">
                                    <span class="control-label col-xs-12 ace-checkbox">
                                        <label class="middle">
                                            @Html.CheckBoxFor(x => x.UserActivated, new { @class = "ace form-control" })
                                            <span class="lbl"> Kích hoạt</span>
                                        </label>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="col-xs-12" style="overflow: auto; max-height: 400px">
                                    <label class="control-label  col-xs-12"> Vai trò</label>
                                    <ul id="browser" class="filetree">
                                        @{
                                            var i = 1;
                                            var j = 1;
                                            foreach (var p in Model.Roles)
                                            {

                                                <li>
                                                    <a href="#">
                                                        <span class="control-label   ace-checkbox">
                                                            <label class="middle">
                                                                @Html.CheckBoxFor(x => p.Selected, new { @class = "ace rightselect", @roleId = p.RoleId })
                                                                <span class="lbl"> @p.RoleName</span>
                                                            </label>
                                                        </span>
                                                    </a>
                                                </li>

                                            }

                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>


                    </div>

                </div>
                <div class="modal-footer">
                    <label id="errormsg" class="error" style="display: inline-block;"></label>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Lưu
                    </button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        <i class="fa fa-close"></i> Hủy
                    </button>
                </div>
                                            }

        </div>

    </div>
    <script>
        jQuery(document).ready(function () {
            $(".ace-checkbox").find("input[type='hidden']").remove();
            App.User.initForm();
        });

    </script>
</div>